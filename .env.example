# RUPP-SPKB v2.0 environment template.
#
# Copy this file to .env and fill in the two secrets. Never commit .env.
# Real environment variables take precedence over values in .env.
#
#   Copy-Item .env.example .env
#
# The bot fails at startup when TELEGRAM_BOT_TOKEN or KB_SALT is missing.
# Offline tools and tests can load config without them.

# --- Required secrets (no values in this example) ----------------------------
# BotFather token, for example 123456789:AA... (never committed).
TELEGRAM_BOT_TOKEN=
# Long random string used to hash Telegram IDs before they are stored/logged.
KB_SALT=

# --- Services ----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://127.0.0.1:11434

# --- Models ------------------------------------------------------------------
# bge-m3 is pulled by Ollama and also used through FlagEmbedding for sparse
# lexical weights. The same revision must encode chunks and queries.
EMBED_MODEL=BAAI/bge-m3
# Pinned Gemma tag. Pull it with: ollama pull gemma4:12b-it-qat
OLLAMA_MODEL=gemma4:12b-it-qat

# --- Answer behavior ---------------------------------------------------------
# false = extractive answers (the V2.0 default). true enables Gemma synthesis.
ENABLE_LLM=false
# Initial placeholder only; Phase 6 replaces it with the swept value.
ABSTAIN_THRESHOLD=0.45

# --- Storage and operations --------------------------------------------------
KB_COLLECTION=rupp_senior_projects_v1
# Optional: DEBUG, INFO, WARNING, ERROR, or CRITICAL (default INFO).
LOG_LEVEL=INFO
