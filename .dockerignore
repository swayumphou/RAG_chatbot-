# Keep secrets, data, and development files out of the image.
.env
.env.*
!.env.example

.git/
.github/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Data and indexes are mounted as volumes at run time, never baked in.
data/
index/
logs/
eval/last_report.json
datasets/training_pairs.jsonl

# Not needed to run the bot.
legacy/
docs/
implementation/
.agents/
tests/
